def _xdg(environ: dict, name: str, fallback: Path) -> Path:
    """An XDG base directory. The specification says a relative value is invalid and must be ignored."""
    value = environ.get(name) or ""
    return Path(value) if value.startswith("/") else fallback


@dataclass
class Env:
    """Everything the tool learns from the machine, so tests can point it at a temp directory."""
    home: Path
    config: Path = field(default=None)  # type: ignore[assignment]
    data: Path = field(default=None)    # type: ignore[assignment]
    which: object = shutil.which
    flatpak_roots: tuple[Path, ...] = ()
    environ: dict = field(default=None)  # type: ignore[assignment]
    cache: Path = field(default=None)   # type: ignore[assignment]
    notes: list = field(default_factory=list)

    def __post_init__(self):
        self.home = Path(self.home)
        if self.environ is None:
            self.environ = dict(os.environ)
        self.xdg_config = _xdg(self.environ, "XDG_CONFIG_HOME", self.home / ".config")
        self.xdg_data = _xdg(self.environ, "XDG_DATA_HOME", self.home / ".local/share")
        self.xdg_cache = _xdg(self.environ, "XDG_CACHE_HOME", self.home / ".cache")
        if self.config is None:
            self.config = self.xdg_config / "xiv-arcade"
        if self.data is None:
            self.data = self.xdg_data / "xiv-arcade"
        if self.cache is None:
            self.cache = self.xdg_cache / "xiv-arcade"
        if not self.flatpak_roots:
            self.flatpak_roots = tuple(dict.fromkeys([Path("/var/lib/flatpak/app"), self.xdg_data / "flatpak/app",
                                                      self.home / ".local/share/flatpak/app"]))

    @classmethod
    def detect(cls, home: Path, environ: dict | None = None, script: Path | None = None, **kw) -> "Env":
        """The directories for a real run. A copy of this tool that the plugin wrote into ".../xiv-arcade/"
        uses that directory, so the plugin and the tool can never disagree about where state.json is. A setup
        made under the default paths before XDG_* pointed elsewhere keeps working where it is: nothing is moved."""
        environ = dict(os.environ) if environ is None else environ
        probe = cls(home, environ=environ, **kw)
        config, data, notes = probe.config, probe.data, []
        if script is not None and script.name == "xiv-arcade" and script.parent.name == "xiv-arcade":
            config = script.parent
        else:
            old = Path(home) / ".config/xiv-arcade"
            if old != config and (old / "config.json").is_file() and not (config / "config.json").is_file():
                notes.append(f"Using your existing settings in {old} (XDG_CONFIG_HOME points at {probe.xdg_config}; nothing was moved).")
                config = old
        old = Path(home) / ".local/share/xiv-arcade"
        if old != data and (old / "sync").is_dir() and not (data / "sync").is_dir():
            notes.append(f"Using your existing saves in {old} (XDG_DATA_HOME points at {probe.xdg_data}; nothing was moved).")
            data = old
        env = cls(home, config=config, data=data, environ=environ, **kw)
        env.notes = notes
        return env

    @property
    def settings_path(self) -> Path:
        return self.config / "config.json"

    @property
    def db_path(self) -> Path:
        return self.config / "arcade.db"

    @property
    def state_path(self) -> Path:
        return self.config / "state.json"

    @property
    def default_sync_root(self) -> Path:
        return self.data / "sync"

    @property
    def sync_root(self) -> Path:
        """The one tree Syncthing replicates: saves/<system>/ and states/<system>/."""
        return Path(self.settings().get("saves") or self.default_sync_root)

    @property
    def backups(self) -> Path:
        return self.data / "backups"

    def settings(self) -> dict:
        try:
            return json.loads(self.settings_path.read_text())
        except (OSError, ValueError):
            return {}

    def games_root(self) -> Path:
        return Path(self.settings().get("games") or self.home / "Games/Arcade")

    def extra_roots(self) -> list[Path]:
        return [Path(p) for p in self.settings().get("more_folders", [])]


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


# --------------------------------------------------------------------------------------------
# Emulator detection and the launch command
# --------------------------------------------------------------------------------------------

@dataclass
class Frontend:
    kind: str            # "flatpak" | "native" | "none"
    core_dirs: list[Path]
    config_dir: Path | None = None   # RetroArch's own config directory (read, never written)

    def argv_prefix(self) -> list[str]:
        return ["flatpak", "run", RETROARCH_FLATPAK] if self.kind == "flatpak" else ["retroarch"]


def flatpak_installed(env: Env, app: str) -> bool:
    return any((r / app).is_dir() for r in env.flatpak_roots)


def _ra_value(config_dir: Path | None, key: str) -> str:
    """One value from the player's retroarch.cfg, read only. "" when unset or "default"."""
    if config_dir is None:
        return ""
    try:
        for line in (config_dir / "retroarch.cfg").read_text(errors="replace").splitlines():
            k, _, v = line.partition("=")
            if k.strip() == key:
                v = v.strip().strip('"')
                return "" if v in ("", "default") else v
    except OSError:
        pass
    return ""


def _ra_path(env: Env, front: Frontend, key: str, default: str) -> Path:
    """A RetroArch directory setting: "~" is the home and ":" RetroArch's own config directory."""
    v = _ra_value(front.config_dir, key)
    if v.startswith("~/"):
        return env.home / v[2:]
    if v.startswith(":/") and front.config_dir:
        return front.config_dir / v[2:]
    return Path(v) if v.startswith("/") else (front.config_dir or env.xdg_config / "retroarch") / default


def find_frontend(env: Env) -> Frontend:
    if flatpak_installed(env, RETROARCH_FLATPAK):
        # a Flatpak app's config is under ~/.var/app whatever XDG_CONFIG_HOME says outside the sandbox
        cfg = env.home / ".var/app" / RETROARCH_FLATPAK / "config/retroarch"
        front = Frontend("flatpak", [], cfg)
        front.core_dirs = list(dict.fromkeys([_ra_path(env, front, "libretro_directory", "cores"), cfg / "cores"]))
        return front
    if env.which("retroarch"):
        front = Frontend("native", [], env.xdg_config / "retroarch")
        front.core_dirs = list(dict.fromkeys([
            _ra_path(env, front, "libretro_directory", "cores"), front.config_dir / "cores", Path("/usr/lib64/libretro"),
            Path("/usr/lib/libretro"), Path("/usr/lib/x86_64-linux-gnu/libretro")]))
        return front
    return Frontend("none", [])


def find_core(front: Frontend, system: System, only: str | None = None) -> Path | None:
    for core in ((only,) if only else system.cores):
        for d in front.core_dirs:
            p = d / f"{core}_libretro.so"
            if p.is_file():
                return p
    return None


def install_line(env: Env) -> str:
    """One line that installs RetroArch and lets its sandbox reach the games and the saves."""
    places = list(dict.fromkeys([str(env.games_root()), str(env.data), str(env.sync_root)]))
    return (f"flatpak install -y flathub {RETROARCH_FLATPAK} && flatpak override --user "
            + " ".join(f"--filesystem={shlex.quote(p)}" for p in places)
            + f" --filesystem={shlex.quote(str(env.config))}:ro {RETROARCH_FLATPAK}")


def core_hint(system: System) -> str:
    alone = [a.name for a in STANDALONES if a.system == system.id]
    return (f"{system.name}: in RetroArch open Main Menu > Online Updater > Core Downloader and get "
            f"\"{system.cores[0]}\" (also accepted: {', '.join(system.cores[1:]) or 'none'})."
            + (f" Or install {' / '.join(alone)} and XivArcade uses that." if alone else ""))


def system_cfg(env: Env, system: System) -> Path:
    return env.config / "cfg" / f"{system.id}.cfg"


def system_cfg_text(env: Env, system: System) -> str:
    """RetroArch overrides appended at launch: saves and states go under the synced tree, by system, the
    same on every machine whatever core runs them. The player's own retroarch.cfg is never edited."""
    saves = env.sync_root / "saves" / system.id
    states = env.sync_root / "states" / system.id
    return "".join(f'{k} = "{v}"\n' for k, v in (
        ("savefile_directory", saves), ("savestate_directory", states),
        ("sort_savefiles_enable", "false"), ("sort_savestates_enable", "false"),
        ("sort_savefiles_by_content_enable", "false"), ("sort_savestates_by_content_enable", "false"),
        ("savefiles_in_content_dir", "false"), ("savestates_in_content_dir", "false"),
        ("autosave_interval", "10"), ("pause_nonactive", "true"),
    ))


def launch_argv(env: Env, front: Frontend, system: System, core: Path, content: str) -> list[str]:
    """Under Flatpak the sandbox is opened for this one run to exactly what the game needs, so the appended
    config, the saves and the game are reachable even if the player never ran the "flatpak override" line."""
    prefix = front.argv_prefix()
    if front.kind == "flatpak":
        reach = list(dict.fromkeys([str(env.games_root()), str(Path(content).parent), str(env.data), str(env.sync_root)]))
        prefix = [*prefix[:2], *[f"--filesystem={p}" for p in reach], f"--filesystem={env.config}:ro", prefix[2]]
    return [*prefix, "-L", str(core), "--appendconfig", str(system_cfg(env, system)), content]


# --------------------------------------------------------------------------------------------
# Standalone emulators. The player's own profile is read, never written: the emulator is started
# against a generated profile in XivArcade's config directory (its XDG directory is redirected for
# that one process), a copy of the player's settings with only the memory-card and save-state
# folders pointed into the synced tree.
# --------------------------------------------------------------------------------------------

@dataclass(frozen=True)
class Standalone:
    id: str
    name: str
    system: str
    flatpak: str
    binaries: tuple[str, ...]
    xdg: str                                  # the XDG variable its profile directory hangs off
    profile: str                              # directory name under it
    ini: str                                  # settings file inside the profile
    folders: tuple[tuple[str, str, str], ...]  # (section, key, "saves" | "states")
    paths: tuple[tuple[str, str, str], ...]    # (section, key, default): relative in the player's ini, made absolute
    args: tuple[str, ...]
    playlists: bool                           # takes an .m3u; otherwise the first disc is passed


STANDALONES: tuple[Standalone, ...] = (
    Standalone("pcsx2", "PCSX2", "ps2", "net.pcsx2.PCSX2", ("pcsx2-qt", "pcsx2"), "XDG_CONFIG_HOME", "PCSX2", "inis/PCSX2.ini",
               (("Folders", "MemoryCards", "saves"), ("Folders", "Savestates", "states")),
               (("Folders", "Bios", "bios"),), ("-batch", "-nogui", "-fullscreen"), False),
    Standalone("duckstation", "DuckStation", "psx", "org.duckstation.DuckStation", ("duckstation-qt", "duckstation"),
               "XDG_DATA_HOME", "duckstation", "settings.ini",
               (("MemoryCards", "Directory", "saves"), ("Folders", "SaveStates", "states")),
               (("BIOS", "SearchDirectory", "bios"),), ("-batch", "-fullscreen"), True),
)
STANDALONE_BY_ID = {a.id: a for a in STANDALONES}


def standalone_kind(env: Env, app: Standalone) -> str:
    """"flatpak", the native binary's name, or "" when it is not installed."""
    if flatpak_installed(env, app.flatpak):
        return "flatpak"
    return next((b for b in app.binaries if env.which(b)), "")


def player_profile(env: Env, app: Standalone, kind: str) -> Path:
    """Where the player's own copy of the emulator keeps its settings."""
    if kind == "flatpak":
        return env.home / ".var/app" / app.flatpak / ("config" if app.xdg == "XDG_CONFIG_HOME" else "data") / app.profile
    return (env.xdg_config if app.xdg == "XDG_CONFIG_HOME" else env.xdg_data) / app.profile


def standalone_root(env: Env, app: Standalone) -> Path:
    """The directory the emulator's XDG variable is pointed at; the generated profile is inside it."""
    return env.config / "emulators" / app.id


def standalone_dirs(env: Env, app: Standalone) -> dict[str, Path]:
    return {kind: env.sync_root / kind / app.system / app.name for kind in ("saves", "states")}


def ini_with(text: str, overrides: dict[tuple[str, str], str], base: Path | None = None, absolute: str = "Folders") -> str:
    """An ini with some keys replaced or added. Relative values in the [absolute] section are resolved
    against `base`, because the copy lives somewhere else than the file it was read from."""
    out, section, left = [], "", dict(overrides)

    def flush():
        out.extend(f"{k} = {v}" for (s, k), v in list(left.items()) if s == section)
        for key in [key for key in left if key[0] == section]:
            del left[key]

    for line in text.splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            flush()
            section = s[1:-1]
        elif "=" in s and not s.startswith((";", "#")):
            k, _, v = (part.strip() for part in s.partition("="))
            if (section, k) in left:
                line = f"{k} = {left.pop((section, k))}"
            elif section == absolute and base is not None and v and not v.startswith("/"):
                line = f"{k} = {base / v}"
        out.append(line)
    flush()
    for s in dict.fromkeys(s for s, _ in left):
        out.append(f"[{s}]")
        section = s
        flush()
    return "\n".join(out) + "\n"


def standalone_ini_text(env: Env, app: Standalone, kind: str) -> str:
    mine = player_profile(env, app, kind)
    try:
        text = (mine / app.ini).read_text(errors="replace")
    except OSError:
        text = ""
    dirs = standalone_dirs(env, app)
    over = {(s, k): str(dirs[which]) for s, k, which in app.folders}
    for s, k, default in app.paths:
        m = re.search(rf"(?ms)^\[{re.escape(s)}\]\s*$.*?^{re.escape(k)}\s*=\s*([^\r\n]*)", text)
        over[(s, k)] = str(mine / ((m.group(1).strip() if m else "") or default))
    return ini_with(text, over, mine)


def standalone_argv(env: Env, app: Standalone, kind: str, game: dict) -> list[str]:
    content = game["path"]
    if content.lower().endswith(".m3u") and not app.playlists and game.get("discs"):
        content = game["discs"][0]
    root = standalone_root(env, app)
    if kind == "flatpak":
        reach = list(dict.fromkeys([str(root), str(env.sync_root), str(Path(content).parent)]))
        return ["flatpak", "run", f"--env={app.xdg}={root}", *[f"--filesystem={p}" for p in reach], app.flatpak,
                *app.args, "--", content]
    return ["env", f"{app.xdg}={root}", kind, *app.args, "--", content]


def prepare_standalone(env: Env, app: Standalone, kind: str) -> Path:
    """Writes the generated profile. Only files under XivArcade's own config directory are touched."""
    for d in standalone_dirs(env, app).values():
        d.mkdir(parents=True, exist_ok=True)
    ini = standalone_root(env, app) / app.profile / app.ini
    atomic_write(ini, standalone_ini_text(env, app, kind))
    return ini


# --------------------------------------------------------------------------------------------
# BIOS files. XivArcade never downloads, links to or helps find one. It says which file the chosen
# emulator reads, where, and whether the file the player put there is the dump it should be.
# Sizes and checksums are facts about a correct dump of the player's own console.
# --------------------------------------------------------------------------------------------

@dataclass(frozen=True)
class BiosFile:
    name: str
    size: int
    md5: str
    what: str


BIOS_FILES: dict[str, tuple[BiosFile, ...]] = {
    "psx": (BiosFile("scph5500.bin", 524288, "8dd7d5296a650fac7319bce665a6a53c", "PlayStation BIOS v3.0, Japan"),
            BiosFile("scph5501.bin", 524288, "490f666e1afb15b7362b406ed1cea246", "PlayStation BIOS v3.0, North America"),
            BiosFile("scph5502.bin", 524288, "32736f17079d0b2b7024407c39bd3050", "PlayStation BIOS v3.0, Europe")),
    "gba": (BiosFile("gba_bios.bin", 16384, "a860e8c0b6d573d191e4ec7db1b1e4f6", "Game Boy Advance BIOS"),),
    "nds": (BiosFile("bios7.bin", 16384, "df692a80a5b1bc90728bc3dfc76cd948", "Nintendo DS ARM7 BIOS"),
            BiosFile("bios9.bin", 4096, "a392174eb3e572fed6447e956bde4b25", "Nintendo DS ARM9 BIOS")),
}
BIOS_FREE_CORES = {"pcsx_rearmed": "PCSX ReARMed's built-in (HLE) BIOS"}
PS2_BIOS_SIZE = 4 * 1024 * 1024
_PS2_REGIONS = {"J": "Japan", "A": "North America", "H": "Asia", "E": "Europe", "C": "China", "T": "Japan (test unit)", "X": "test unit"}


def _md5(path: Path) -> str:
    h = hashlib.md5()  # nosec B324: identifying a known dump, not security
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def ps2_romver(path: Path) -> str | None:
    """The ROMVER string of a PS2 BIOS dump ("0160EC20020426"), found the way the emulator finds it: the
    ROMDIR table starts at the "RESET" entry and lists every module with its size. None: not a PS2 BIOS."""
    try:
        with open(path, "rb") as f:
            data = f.read(PS2_BIOS_SIZE)
    except OSError:
        return None
    at = next((i for i in range(0, max(0, len(data) - 16), 16) if data[i:i + 6] == b"RESET\0"), -1)
    offset = 0
    while 0 <= at <= len(data) - 16 and data[at] != 0:
        name = data[at:at + 10].split(b"\0")[0]
        size = int.from_bytes(data[at + 12:at + 16], "little")
        if name == b"ROMVER":
            ver = data[offset:offset + 14].decode("ascii", "replace")
            return ver if re.fullmatch(r"\d{4}[A-Z]{2}\d{8}", ver) else None
        offset += (size + 15) & ~15
        at += 16
    return None


def check_bios_file(folder: Path, want: BiosFile, known: tuple[BiosFile, ...]) -> dict:
    row = {"name": want.name, "what": want.what, "size": want.size, "md5": want.md5, "state": "missing", "detail": ""}
    try:
        found = next((p for p in sorted(folder.iterdir()) if p.is_file() and p.name.lower() == want.name.lower()), None)
    except OSError:
        found = None
    if found is None:
        return row
    row["state"] = "wrong"
    size = found.stat().st_size
    if size != want.size:
        row["detail"] = f"{found.name} is {size:,} bytes; a correct dump is {want.size:,} bytes."
        return row
    digest = _md5(found)
    if digest != want.md5:
        other = next((k for k in known if k.md5 == digest), None)
        row["detail"] = (f"{found.name} is really \"{other.what}\": rename it to {other.name}." if other else
                         f"{found.name} has MD5 {digest}, expected {want.md5}: a different revision or region, or a bad dump.")
        return row
    if found.name != want.name:
        row["detail"] = f"Right file, but rename {found.name} to {want.name} (lower case)."
        return row
    row["state"] = "ok"
    return row


def bios_dir(env: Env, front: Frontend, system: System, choice: "Choice | None") -> Path | None:
    if choice is not None and choice.standalone is not None:
        app = choice.standalone
        mine = player_profile(env, app, choice.kind)
        s, k, default = app.paths[0]
        line = next((ln for ln in standalone_ini_text(env, app, choice.kind).splitlines() if ln.startswith(k + " = ")), "")
        return Path(line.partition(" = ")[2]) if line else mine / default
    if front.kind == "none":
        return None
    system_dir = _ra_path(env, front, "system_directory", "system")
    return system_dir / "pcsx2/bios" if system.id == "ps2" else system_dir


def bios_report(env: Env, front: Frontend, system: System, choice: "Choice | None") -> dict | None:
    """What the chosen emulator wants for this console, and what is there. None: this console needs none."""
    if system.id != "ps2" and system.id not in BIOS_FILES:
        return None
    folder = bios_dir(env, front, system, choice)
    where = str(folder) if folder else "the emulator's BIOS folder (named here once an emulator is installed)"
    rep = {"system": system.id, "dir": str(folder) if folder else "", "required": system.id in ("psx", "ps2"), "ok": False,
           "hle": False, "files": [], "summary": ""}
    if system.id == "ps2":
        dumps, others = [], 0
        try:
            entries = [p for p in sorted(folder.iterdir()) if p.is_file()] if folder else []
        except OSError:
            entries = []
        for p in entries:
            ver = ps2_romver(p) if p.stat().st_size >= 1 << 19 else None
            if ver:
                dumps.append(f"{p.name}: v{ver[:2].lstrip('0') or '0'}.{ver[2:4]} {_PS2_REGIONS.get(ver[4], 'unknown region')}")
            elif p.suffix.lower() in (".bin", ".rom", ".rom0"):
                others += 1
        rep["files"] = [{"name": "any PlayStation 2 BIOS dump (.bin)", "what": "from your own console", "size": PS2_BIOS_SIZE,
                         "md5": "", "state": "ok" if dumps else "wrong" if others else "missing",
                         "detail": "; ".join(dumps) if dumps else
                         f"{others} file(s) here, but none is a PlayStation 2 BIOS (no ROMDIR/ROMVER inside)." if others else ""}]
        rep["ok"] = bool(dumps)
        rep["summary"] = ("PlayStation 2 BIOS found: " + "; ".join(dumps) if dumps else
                          "PlayStation 2 always needs a BIOS dumped from your own console: no emulator or core has a BIOS-free "
                          f"mode. Put your dump (usually {PS2_BIOS_SIZE:,} bytes; every console revision has its own checksum, so "
                          f"the file is checked by its contents) in {where}.")
        return rep
    known = BIOS_FILES[system.id]
    rep["files"] = [check_bios_file(folder or Path("/nonexistent"), w, known) for w in known]
    good = [f for f in rep["files"] if f["state"] == "ok"]
    bad = [f for f in rep["files"] if f["state"] == "wrong"]
    rep["ok"] = bool(good) if system.id == "psx" else len(good) == len(known)
    rep["hle"] = system.id == "psx" and not rep["ok"] and choice is not None and choice.id in BIOS_FREE_CORES
    wants = ", ".join(f"{w.name} ({w.size:,} bytes, MD5 {w.md5}; {w.what})" for w in known)
    if rep["ok"]:
        rep["summary"] = "BIOS found: " + ", ".join(f["name"] for f in good) + "." + (
            " Some cores need the BIOS of the game's own region." if system.id == "psx" and len(good) < len(known) else "")
    elif rep["hle"]:
        rep["summary"] = (f"No BIOS needed: running on {BIOS_FREE_CORES[choice.id]}, lower compatibility. For the accurate cores, "
                          f"put your own dump in {where}: {wants}.")
    elif rep["required"]:
        rep["summary"] = (f"Put a BIOS dumped from your own console in {where}: one of {wants}."
                          + (" Or get the \"pcsx_rearmed\" core: it starts games without a BIOS, at lower compatibility."
                             if system.id == "psx" and (choice is None or choice.standalone is None) else ""))
    else:
        rep["summary"] = f"Optional: the core has a built-in replacement. For the original, put your own dump in {where}: {wants}."
    if system.id == "psx" and not rep["ok"] and not rep["hle"] and folder is not None and _psx_has_bios(env, front):
        rep["summary"] += (" There is a BIOS-sized file here that is not one of these three dumps: SwanStation and DuckStation "
                           "accept other revisions, Beetle PSX does not.")
    if bad:
        rep["summary"] += " Wrong file: " + " ".join(f["detail"] for f in bad)
    return rep


# --------------------------------------------------------------------------------------------
# Which emulator runs a console: the player's preference, else the best one installed
# --------------------------------------------------------------------------------------------

@dataclass
class Choice:
    kind: str                          # "retroarch", or for a standalone "flatpak" / its binary's name
    id: str                            # the core's stem, or the standalone's id
    label: str
    core: Path | None = None
    standalone: Standalone | None = None


def _psx_has_bios(env: Env, front: Frontend) -> bool:
    """Any BIOS-sized file counts here: a revision this list does not know must not push the player onto HLE."""
    folder = bios_dir(env, front, SYSTEM_BY_ID["psx"], None)
    try:
        return folder is not None and any(p.is_file() and p.stat().st_size == 524288 for p in folder.iterdir())
    except OSError:
        return False


def emulator_options(env: Env, front: Frontend, system: System) -> list[dict]:
    """Every emulator XivArcade can start for a console, installed or not, in the order "auto" tries them."""
    out = []
    for core in system.cores:
        free = core in BIOS_FREE_CORES
        out.append({"id": "retroarch:" + core, "label": f"RetroArch · {core}" + (" (no BIOS needed, lower compatibility)" if free else ""),
                    "installed": find_core(front, system, core) is not None, "bios_free": free})
    for app in STANDALONES:
        if app.system == system.id:
            out.append({"id": app.id, "label": app.name + " (standalone)", "installed": bool(standalone_kind(env, app)), "bios_free": False})
    return out


def preference(env: Env, system: System, game_id: str | None = None) -> str:
    s = env.settings()
    return (s.get("game_emulators", {}).get(game_id or "") or s.get("emulators", {}).get(system.id) or "auto").lower()


def choose_emulator(env: Env, front: Frontend, system: System, game_id: str | None = None) -> Choice | None:
    def core_choice(core: str | None) -> Choice | None:
        p = find_core(front, system, core)
        return Choice("retroarch", p.stem.replace("_libretro", ""), "RetroArch · " + p.stem.replace("_libretro", ""), core=p) if p else None

    def alone_choice(app: Standalone) -> Choice | None:
        kind = standalone_kind(env, app)
        return Choice(kind, app.id, app.name + " (standalone)", standalone=app) if kind else None

    pref = preference(env, system, game_id)
    picked = None
    if pref in STANDALONE_BY_ID and STANDALONE_BY_ID[pref].system == system.id:
        picked = alone_choice(STANDALONE_BY_ID[pref])
    elif pref.startswith("retroarch:"):
        picked = core_choice(pref.split(":", 1)[1])
    elif pref == "retroarch":
        return core_choice(None)
    if picked:
        return picked
    if system.id == "psx" and front.kind != "none" and not _psx_has_bios(env, front):
        picked = next((c for c in map(core_choice, BIOS_FREE_CORES) if c), None)  # FF VII-IX start without a BIOS
    return picked or core_choice(None) or next((c for c in (alone_choice(a) for a in STANDALONES if a.system == system.id) if c), None)


def set_preference(env: Env, target: str, value: str, games: list[dict]) -> str:
    """`target` is a console id, or a game id / name. Returns what was set, for the player."""
    s, value = env.settings(), value.lower()
    system = SYSTEM_BY_ID.get(target.lower())
    game = None if system else next((g for g in games if g["id"] == target), None) or fuzzy_pick(games, target)
    if system is None and game is None:
        raise Refused(f"\"{target}\" is neither a console ({', '.join(SYSTEM_BY_ID)}) nor a game in the library")
    sysid = system.id if system else game["system"]
    valid = ["auto", "retroarch", *[o["id"] for o in emulator_options(env, Frontend("none", []), SYSTEM_BY_ID[sysid])]]
    if value not in valid:
        raise Refused(f"\"{value}\" is not an emulator for {SYSTEM_BY_ID[sysid].name}; choose one of: {', '.join(valid)}")
    table = s.setdefault("emulators" if system else "game_emulators", {})
    key = sysid if system else game["id"]
    if value == "auto":
        table.pop(key, None)
    else:
        table[key] = value
    atomic_write(env.settings_path, json.dumps(s, indent=2) + "\n")
    return f"{system.name if system else game['title']}: {value}"


# --------------------------------------------------------------------------------------------
# The SQLite index: library, play history, sync state
# --------------------------------------------------------------------------------------------

SCHEMA = """
CREATE TABLE IF NOT EXISTS games (
  id TEXT PRIMARY KEY, title TEXT NOT NULL, sort_title TEXT, year INTEGER, system TEXT NOT NULL, path TEXT NOT NULL,
  discs TEXT NOT NULL DEFAULT '[]', ff TEXT NOT NULL DEFAULT '[]', boxart TEXT,
  present INTEGER NOT NULL DEFAULT 1, first_seen REAL NOT NULL, last_seen REAL NOT NULL);
CREATE TABLE IF NOT EXISTS plays (
  id INTEGER PRIMARY KEY, game_id TEXT NOT NULL, core TEXT, started REAL NOT NULL, ended REAL, exit_code INTEGER);
CREATE INDEX IF NOT EXISTS plays_game ON plays(game_id, started);
CREATE TABLE IF NOT EXISTS sync_state (key TEXT PRIMARY KEY, value TEXT NOT NULL, at REAL NOT NULL);
CREATE TABLE IF NOT EXISTS conflicts (
  id INTEGER PRIMARY KEY, live TEXT NOT NULL, kept_as TEXT NOT NULL, live_mtime REAL, kept_mtime REAL, at REAL NOT NULL);
"""


def game_id(system: str, title: str) -> str:
    """Stable across machines: the same title on the same system is the same game wherever the file lives."""
    return hashlib.sha1(f"{system}/{normalize(title)}".encode()).hexdigest()[:12]


class Index:
    def __init__(self, path: Path | str):
        if path != ":memory:":
            Path(path).parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(str(path))
        self.db.row_factory = sqlite3.Row
        self.db.executescript(SCHEMA)
        self.db.execute(f"PRAGMA user_version = {VERSION}")

    def close(self):
        self.db.close()

    def replace_library(self, games: list[dict], now: float | None = None) -> None:
        """Upserts what the scan found and marks the rest absent. History survives a file going away
        and coming back, because the id is the title, not the path."""
        now = time.time() if now is None else now
        with self.db:
            self.db.execute("UPDATE games SET present = 0")
            for g in games:
                self.db.execute(
                    "INSERT INTO games (id, title, sort_title, year, system, path, discs, ff, boxart, present, first_seen, last_seen) "
                    "VALUES (?,?,?,?,?,?,?,?,?,1,?,?) ON CONFLICT(id) DO UPDATE SET title=excluded.title, path=excluded.path, "
                    "sort_title=excluded.sort_title, year=excluded.year, "
                    "discs=excluded.discs, ff=excluded.ff, boxart=excluded.boxart, present=1, last_seen=excluded.last_seen",
                    (g["id"], g["title"], g.get("sort_title") or g["title"], g.get("year"), g["system"], g["path"],
                     json.dumps(g.get("discs", [])),
                     json.dumps(g.get("ff", [])), g.get("boxart"), now, now))

    def games(self) -> list[dict]:
        rows = self.db.execute(
            "SELECT g.*, (SELECT MAX(started) FROM plays p WHERE p.game_id = g.id) AS last_played "
            "FROM games g WHERE present = 1 ORDER BY COALESCE(sort_title, title) COLLATE NOCASE").fetchall()
        out = []
        for r in rows:
            d = dict(r)
            d["discs"], d["ff"] = json.loads(d["discs"]), json.loads(d["ff"])
            out.append(d)
        return out

    def start_play(self, gid: str, core: str, now: float | None = None) -> int:
        with self.db:
            return self.db.execute("INSERT INTO plays (game_id, core, started) VALUES (?,?,?)",
                                   (gid, core, time.time() if now is None else now)).lastrowid

    def end_play(self, play: int, code: int, now: float | None = None) -> None:
        with self.db:
            self.db.execute("UPDATE plays SET ended = ?, exit_code = ? WHERE id = ?",
                            (time.time() if now is None else now, code, play))

    def last_played(self) -> dict | None:
        r = self.db.execute("SELECT g.id FROM plays p JOIN games g ON g.id = p.game_id AND g.present = 1 "
                            "ORDER BY p.started DESC LIMIT 1").fetchone()
        return next((g for g in self.games() if g["id"] == r["id"]), None) if r else None

    def set_state(self, key: str, value, now: float | None = None) -> None:
        with self.db:
            self.db.execute("INSERT INTO sync_state (key, value, at) VALUES (?,?,?) ON CONFLICT(key) DO UPDATE SET "
                            "value=excluded.value, at=excluded.at", (key, json.dumps(value), time.time() if now is None else now))

    def get_state(self, key: str, default=None):
        r = self.db.execute("SELECT value FROM sync_state WHERE key = ?", (key,)).fetchone()
        return json.loads(r["value"]) if r else default

    def add_conflict(self, c: "Resolved") -> None:
        with self.db:
            self.db.execute("INSERT INTO conflicts (live, kept_as, live_mtime, kept_mtime, at) VALUES (?,?,?,?,?)",
                            (c.live, c.kept_as, c.live_mtime, c.kept_mtime, time.time()))

    def recent_conflicts(self, limit: int = 5) -> list[dict]:
        return [dict(r) for r in self.db.execute("SELECT * FROM conflicts ORDER BY at DESC LIMIT ?", (limit,))]


