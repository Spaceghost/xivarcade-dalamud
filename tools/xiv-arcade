def _fold(name: str) -> str:
    return re.sub(r"[^a-z0-9]", "", name.lower())


_FOLDERS = {}
for _s in SYSTEMS:
    for _n in (_s.id, _s.folder, *_s.aliases):
        _FOLDERS[_fold(_n)] = _s
_UNIQUE = {e: s for s in SYSTEMS for e in s.unique}


def detect_system(path: str, root: str = "") -> System | None:
    """The system a file belongs to: the nearest system-named folder below the games root wins,
    then an extension only one system uses. An ambiguous image (.iso, .chd, .bin, .pbp) outside a
    system folder is None: the player has to say which console it is by putting it in a folder."""
    p = Path(path)
    ext = p.suffix.lower()
    try:
        parts = p.relative_to(root).parts[:-1] if root else p.parts[:-1]
    except ValueError:
        parts = p.parts[:-1]
    for part in reversed(parts):
        s = _FOLDERS.get(_fold(part))
        if s is not None:
            return s if ext in s.exts else None
    return _UNIQUE.get(ext)


# --------------------------------------------------------------------------------------------
# Titles, discs, playlists
# --------------------------------------------------------------------------------------------

_DISC = re.compile(r"[\s._-]*[(\[]\s*(?:disc|disk|cd)\s*([0-9]+|[a-d])(?:\s*of\s*[0-9]+)?\s*[)\]]", re.I)
_TAGS = re.compile(r"\s*[(\[][^)\]]*[)\]]")


def disc_number(stem: str) -> int | None:
    m = _DISC.search(stem)
    if not m:
        return None
    d = m.group(1).lower()
    return int(d) if d.isdigit() else "abcd".index(d) + 1


def strip_disc(stem: str) -> str:
    return _DISC.sub("", stem).strip()


def clean_title(stem: str) -> str:
    """"Final Fantasy VII (USA) (Disc 1)" -> "Final Fantasy VII"; "Legend of X, The" -> "The Legend of X"."""
    t = _TAGS.sub("", stem.replace("_", " ")).strip(" -._")
    m = re.match(r"^(.*), (The|A|An)(\b.*)?$", t)
    if m:
        t = f"{m.group(2)} {m.group(1)}{m.group(3) or ''}"
    return re.sub(r"\s+", " ", t).strip() or stem


def m3u_text(disc_paths: list[str]) -> str:
    """A RetroArch playlist: one disc per line, in disc order."""
    return "".join(p + "\n" for p in disc_paths)


def group_discs(files: list[str]) -> tuple[dict[str, list[str]], list[str]]:
    """Splits content files into multi-disc sets and single files. A set is two or more files in one
    directory whose names differ only by their "(Disc N)" tag. Returns ({set stem: [paths in disc
    order]}, [everything else])."""
    sets: dict[tuple[str, str], list[tuple[int, str]]] = {}
    singles: list[str] = []
    for f in files:
        p = Path(f)
        n = disc_number(p.stem)
        if n is None:
            singles.append(f)
        else:
            sets.setdefault((str(p.parent), strip_disc(p.stem)), []).append((n, f))
    out: dict[str, list[str]] = {}
    for (parent, stem), discs in sets.items():
        if len(discs) < 2:
            singles.extend(f for _, f in discs)
        else:
            out[str(Path(parent) / stem)] = [f for _, f in sorted(discs)]
    return out, singles


